# Copy to .env and fill in. Real environment variables take precedence over this file.

# Reads bill photos with OCR.space (free key: https://ocr.space/ocrapi). Photos are sent to OCR.space.
OCR_SPACE_API_KEY=

# Optional: Claude vision reads photos instead (used first when set).
# ANTHROPIC_API_KEY=

# Optional demo settings
# ANNA_DEMO=1
